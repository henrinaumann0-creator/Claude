{
  "name": "claude-pets",
  "productName": "Claude Pets",
  "version": "1.2.0",
  "description": "Ein animierter Desktop-Begleiter mit Level-System, Belohnungen, Gedankenblasen und einer Pixel-Arcade – im Claude-Look.",
  "main": "src/main/main.js",
  "author": "Henri Naumann",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "build:web": "node build/build-web.js",
    "build:single": "node build/build-single.js",
    "serve:web": "node build/build-web.js && node build/serve-web.js",
    "icons": "node build/make-icons.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "de.henri.claudepets",
    "productName": "Claude Pets",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
